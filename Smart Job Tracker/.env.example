# Copy this file to .env and fill in real values before running in production.

# Environment: development, staging, or production
ENVIRONMENT=development

# Secret key used to sign JWTs. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_IN_PRODUCTION

# JWT signing algorithm
ALGORITHM=HS256

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database connection string (SQLite by default — no setup required)
# For SQLite (local development):
DATABASE_URL=sqlite:///./job_tracker.db

# For PostgreSQL/Supabase (production):
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# Frontend URL for CORS (optional, for production deployment)
# FRONTEND_URL=https://your-frontend-domain.com

# AI / LLM
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
